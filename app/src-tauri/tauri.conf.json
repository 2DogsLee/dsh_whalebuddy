{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-pet",
  "version": "0.1.0",
  "identifier": "dev.dsh.pet.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "dsh-pet",
        "width": 178,
        "height": 210,
        "x": 1100,
        "y": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
